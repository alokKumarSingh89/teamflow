{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "rspack"
  },
  "monorepo": true,
  "projects": {
    "api-gateway": {
      "type": "application",
      "root": "apps/api-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/api-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-gateway/tsconfig.app.json"
      }
    },
    "auth-client": {
      "type": "library",
      "root": "libs/auth-client",
      "entryFile": "index",
      "sourceRoot": "libs/auth-client/src",
      "compilerOptions": {
        "tsConfigPath": "libs/auth-client/tsconfig.lib.json"
      }
    },
    "config": {
      "type": "library",
      "root": "libs/config",
      "entryFile": "index",
      "sourceRoot": "libs/config/src",
      "compilerOptions": {
        "tsConfigPath": "libs/config/tsconfig.lib.json"
      }
    },
    "events": {
      "type": "library",
      "root": "libs/events",
      "entryFile": "index",
      "sourceRoot": "libs/events/src",
      "compilerOptions": {
        "tsConfigPath": "libs/events/tsconfig.lib.json"
      }
    },
    "logger": {
      "type": "library",
      "root": "libs/logger",
      "entryFile": "index",
      "sourceRoot": "libs/logger/src",
      "compilerOptions": {
        "tsConfigPath": "libs/logger/tsconfig.lib.json"
      }
    },
    "notification-worker": {
      "type": "application",
      "root": "apps/notification-worker",
      "entryFile": "main",
      "sourceRoot": "apps/notification-worker/src",
      "compilerOptions": {
        "tsConfigPath": "apps/notification-worker/tsconfig.app.json"
      }
    },
    "project-subgraph": {
      "type": "application",
      "root": "apps/project-subgraph",
      "entryFile": "main",
      "sourceRoot": "apps/project-subgraph/src",
      "compilerOptions": {
        "tsConfigPath": "apps/project-subgraph/tsconfig.app.json"
      }
    },
    "task-subgraph": {
      "type": "application",
      "root": "apps/task-subgraph",
      "entryFile": "main",
      "sourceRoot": "apps/task-subgraph/src",
      "compilerOptions": {
        "tsConfigPath": "apps/task-subgraph/tsconfig.app.json"
      }
    },
    "user-subgraph": {
      "type": "application",
      "root": "apps/user-subgraph",
      "entryFile": "main",
      "sourceRoot": "apps/user-subgraph/src",
      "compilerOptions": {
        "tsConfigPath": "apps/user-subgraph/tsconfig.app.json"
      }
    }
  }
}