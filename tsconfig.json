{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "types": ["node", "jest"],
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "paths": {
      "@app/auth-client": ["./libs/auth-client/src"],
      "@app/auth-client/*": ["./libs/auth-client/src/*"],
      "@app/config": ["./libs/config/src"],
      "@app/config/*": ["./libs/config/src/*"],
      "@app/events": ["./libs/events/src"],
      "@app/events/*": ["./libs/events/src/*"],
      "@app/logger": ["./libs/logger/src"],
      "@app/logger/*": ["./libs/logger/src/*"]
    }
  },
  "files": [],
  "references": [
    {
      "path": "./apps/user-subgraph/tsconfig.app.json"
    },
    {
      "path": "./apps/project-subgraph/tsconfig.app.json"
    },
    {
      "path": "./apps/task-subgraph/tsconfig.app.json"
    },
    {
      "path": "./apps/notification-worker/tsconfig.app.json"
    },
    {
      "path": "./apps/api-gateway/tsconfig.app.json"
    }
  ]
}
